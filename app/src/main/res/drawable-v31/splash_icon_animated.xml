<?xml version="1.0" encoding="utf-8"?>
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/splash_icon">

    <target android:name="shapeAGroup">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:propertyName="scaleX"
                    android:valueFrom="0.3"
                    android:valueTo="1.0"
                    android:startOffset="0"
                    android:duration="480"
                    android:interpolator="@interpolator/expressive_overshoot" />
                <objectAnimator
                    android:propertyName="scaleY"
                    android:valueFrom="0.3"
                    android:valueTo="1.0"
                    android:startOffset="0"
                    android:duration="480"
                    android:interpolator="@interpolator/expressive_overshoot" />
                <objectAnimator
                    android:propertyName="rotation"
                    android:valueFrom="0"
                    android:valueTo="140"
                    android:duration="1000"
                    android:interpolator="@android:interpolator/linear" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="shapeBGroup">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:propertyName="scaleX"
                    android:valueFrom="0.3"
                    android:valueTo="1.0"
                    android:startOffset="90"
                    android:duration="480"
                    android:interpolator="@interpolator/expressive_overshoot" />
                <objectAnimator
                    android:propertyName="scaleY"
                    android:valueFrom="0.3"
                    android:valueTo="1.0"
                    android:startOffset="90"
                    android:duration="480"
                    android:interpolator="@interpolator/expressive_overshoot" />
                <objectAnimator
                    android:propertyName="rotation"
                    android:valueFrom="0"
                    android:valueTo="-140"
                    android:duration="1000"
                    android:interpolator="@android:interpolator/linear" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="logoGroup">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:propertyName="scaleX"
                    android:valueFrom="0.4"
                    android:valueTo="1.0"
                    android:startOffset="180"
                    android:duration="460"
                    android:interpolator="@interpolator/expressive_overshoot" />
                <objectAnimator
                    android:propertyName="scaleY"
                    android:valueFrom="0.4"
                    android:valueTo="1.0"
                    android:startOffset="180"
                    android:duration="460"
                    android:interpolator="@interpolator/expressive_overshoot" />
                <objectAnimator
                    android:propertyName="scaleX"
                    android:valueFrom="1.0"
                    android:valueTo="2.6"
                    android:startOffset="700"
                    android:duration="300"
                    android:interpolator="@android:interpolator/accelerate_cubic" />
                <objectAnimator
                    android:propertyName="scaleY"
                    android:valueFrom="1.0"
                    android:valueTo="2.6"
                    android:startOffset="700"
                    android:duration="300"
                    android:interpolator="@android:interpolator/accelerate_cubic" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="shapeA">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="fillAlpha"
                android:valueFrom="1.0"
                android:valueTo="0.0"
                android:startOffset="620"
                android:duration="250"
                android:interpolator="@android:interpolator/accelerate_quad" />
        </aapt:attr>
    </target>

    <target android:name="shapeB">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="fillAlpha"
                android:valueFrom="0.35"
                android:valueTo="0.0"
                android:startOffset="620"
                android:duration="250"
                android:interpolator="@android:interpolator/accelerate_quad" />
        </aapt:attr>
    </target>

    <target android:name="root">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="alpha"
                android:valueFrom="1.0"
                android:valueTo="0.0"
                android:startOffset="780"
                android:duration="220"
                android:interpolator="@android:interpolator/accelerate_quad" />
        </aapt:attr>
    </target>
</animated-vector>
